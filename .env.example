# Public frontend identifiers only. Do not put secret keys in VITE_* variables.
# Settings loads managed sign-in and private student profiles when these are configured.
VITE_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Set AUTH_JWT_ISSUER in the Convex dashboard server environment, not here.
# Resend credentials and any future auth/webhook secrets belong on the server only.
