{
  "name": "student-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:server": "vitest run",
    "check:server": "tsc --project convex/tsconfig.json --noEmit",
    "lint:security": "node scripts/security-check.mjs",
    "check:security-history": "node scripts/security-check.mjs --history",
    "verify": "npm run lint:security && npm test && npm run test:server && npm run check:server && npm audit --audit-level=high",
    "build:release": "npm run verify && node scripts/release-build.mjs",
    "build:hosting": "npm run verify && node scripts/hosting-build.mjs && npm run lint:security"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@clerk/localizations": "^4.22.1",
    "@clerk/react": "^6.17.7",
    "@clerk/ui": "1.39.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/utils": "^6.0.22",
    "convex": "^1.46.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.4",
    "lenis": "^1.3.26",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "convex-test": "^0.0.60",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
